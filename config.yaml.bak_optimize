  run_on_first_block: true
  test_block_sizes:
  - 500
  - 1000
  - 1500
  - 2000
  - 3000
block_size: 1000
cores: 6
days: 366
fit_variable_index: 1
logging:
  level: INFO
  log_file: climatology.log
  log_timestamps: true
paths:
