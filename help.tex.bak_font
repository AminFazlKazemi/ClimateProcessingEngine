\chapter{Execution Flow}
\section{Main Function}
\begin{lstlisting}[caption=Main Execution Flow]
def main():
    # 1. Load configuration
    # 2. Get station information from input data
    # 3. Build calendar and runtime tables
    # 4. Run benchmark (if enabled)
    # 5. Create Zarr output store
    # 6. Load checkpoint (if exists)
    # 7. Process blocks in a loop
    #    - For each block: load, validate, analyze, write, checkpoint
    # 8. Finalize Zarr store
    #    - Add coordinates and metadata
    #    - Consolidate metadata
    # 9. Delete checkpoint
    # 10. Log completion
\end{lstlisting}

\section{Block Processing Flow}
\begin{figure}[H]
    \centering
    \begin{enumerate}
        \item Load data for block
        \item Validate loaded data
        \item Analyze each station
        \item Validate results
        \item Write results to Zarr
        \item Save checkpoint
    \end{enumerate}
    \caption{Block Processing Steps}
    \label{fig:block_flow}
\end{figure}

\section{Recovery Flow}
When a failure occurs:
\begin{enumerate}
    \item On startup, check for checkpoint file
    \item If checkpoint exists, load the last successful block
    \item Resume processing from the next station in that block
    \item Continue with the main processing loop
\end{enumerate}

