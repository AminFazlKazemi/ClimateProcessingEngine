\chapter{Core Modules Reference}

\section{Configuration Module (\texttt{constants.py})}
\subsection{Overview}
The \texttt{constants.py} module loads configuration from \texttt{config.yaml} and defines all constants used throughout the engine.

\subsection{Key Constants}
\begin{lstlisting}[caption=Constants Defined]
# Time
YEAR_START = 1369
YEAR_END = 1399
N_YEARS = 31
N_DAYS = 366
WINDOW_DAYS = 2
WINDOW_SIZE = 5              # 2*window_days + 1

# Variables
VARS = ['tmin', 'tmean', 'tmax']
N_VARS = 3
FIT_VARS = ['tmin', 'tmean', 'tmax']
N_OUTPUTS = 90               # 30 outputs per variable × 3 variables

# Paths
ZARR_BASE = "..."
OUTPUT_DIR = "..."
OUTPUT_ZARR = "..."

# Processing
BLOCK_SIZE = 1000
N_CORES = 6
USE_PARALLEL = False

# Validation thresholds
MAX_VALUES_PER_FIT = 155     # N_YEARS * WINDOW_SIZE
MIN_VALID_VALUES = 5
VALID_BEST_DIST = {-1, 0, 1, 2, 3}

# Data types
FLOAT_DTYPE = np.float32
INT_DTYPE = np.int32
\end{lstlisting}

