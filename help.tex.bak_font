\chapter{Installation and Setup}
\section{Installation}
\subsection{Clone the Repository}
\begin{lstlisting}[caption=Cloning the Repository]
git clone https://github.com/AminFazlKazemi/ClimateProcessingEngine.git
cd ClimateProcessingEngine
\end{lstlisting}

\subsection{Create a Virtual Environment}
\begin{lstlisting}[caption=Creating Virtual Environment]
# Windows
python -m venv venv
venv\Scripts\activate

# Linux/macOS
python3 -m venv venv
source venv/bin/activate
\end{lstlisting}

\subsection{Install Dependencies}
\begin{lstlisting}[caption=Installing Dependencies]
pip install -r requirements.txt
\end{lstlisting}

\section{Configuration}
\subsection{Configuration File Structure}
The \texttt{config.yaml} file contains all runtime settings:
\begin{lstlisting}[caption=Example config.yaml]
# Paths
paths:
  calendar_file: K:/Temp/needed/calendar.txt
  checkpoint_file: checkpoint.csv
  output_dir: I:/climatology_366_rolling
  output_zarr_name: climatology_stationwise_final.zarr
  zarr_base: K:/gozareshha/dr vazife/140504 - qc temp/zarr_yearly_monthly

# Time Range
years:
  start: 1369
  end: 1399
days: 366
window_days: 2

# Processing
block_size: 1000
cores: 6
use_parallel: false

# Variables
variables:
- tmin
- tmean
- tmax
fit_variable_index: 1

# Validation
validation:
  validate_after_load: true
  validate_before_write: true
  validate_every_n_blocks: 5

# Logging
logging:
  level: INFO
  log_file: climatology.log
  log_timestamps: true

# Benchmark
benchmark:
  enabled: true
  run_on_first_block: true
  test_block_sizes:
  - 500
  - 1000
  - 1500
  - 2000
  - 3000
\end{lstlisting}

\subsection{Understanding Configuration Parameters}
\subsubsection{Paths}
\begin{table}[H]
    \centering
    \caption{Path Configuration Parameters}
    \begin{tabular}{p{4cm} p{8cm}}
        \toprule
        \textbf{Parameter} & \textbf{Description} \\
        \midrule
        \texttt{calendar\_file} & Path to the Persian calendar mapping file \\
        \texttt{checkpoint\_file} & Location for storing recovery checkpoint \\
        \texttt{output\_dir} & Directory where output Zarr will be saved \\
        \texttt{output\_zarr\_name} & Name of the output Zarr file \\
        \texttt{zarr\_base} & Directory containing input Zarr files (organized as \texttt{YYYY\_MM.zarr}) \\
        \bottomrule
    \end{tabular}
\end{table}

\subsubsection{Time Configuration}
\begin{table}[H]
    \centering
    \caption{Time Configuration Parameters}
    \begin{tabular}{p{4cm} p{8cm}}
        \toprule
        \textbf{Parameter} & \textbf{Description} \\
        \midrule
        \texttt{years.start} & First year of the analysis (Persian calendar) \\
        \texttt{years.end} & Last year of the analysis (inclusive) \\
        \texttt{days} & Number of days in the year (365 or 366) \\
        \texttt{window\_days} & Days before/after each target day for window extraction \\
        \bottomrule
    \end{tabular}
\end{table}
The window size is calculated as: \texttt{WINDOW\_SIZE = 2 * window\_days + 1}

\subsubsection{Processing Configuration}
\begin{table}[H]
    \centering
    \caption{Processing Configuration Parameters}
    \begin{tabular}{p{4cm} p{8cm}}
        \toprule
        \textbf{Parameter} & \textbf{Description} \\
        \midrule
        \texttt{block\_size} & Number of stations per processing block \\
        \texttt{cores} & Number of CPU cores to use when parallel processing is enabled \\
        \texttt{use\_parallel} & If true, enables multi-core processing \\
        \bottomrule
    \end{tabular}
\end{table}

\section{Preparing Input Data}
\subsection{Input Zarr Structure}
The engine expects input Zarr files organized by year and month:
\begin{lstlisting}[caption=Input Zarr Directory Structure]
zarr_base/
+---- 1369_01.zarr/
|   +---- tmin (2D: day, point)
|   +---- tmax (2D: day, point)
|   +---- tmean (2D: day, point)
|   +---- stationid (1D: point)
|   +---- lat (1D: point)
|   +---- lon (1D: point)
|   +---- elev (1D: point)
+---- 1369_02.zarr/
+---- ...
\end{lstlisting}

\subsection{Calendar File Format}
The calendar file (\texttt{calendar.txt}) maps Persian dates to day-of-year indices:
\begin{lstlisting}[caption=calendar.txt Format]
ShamsiDate  ShamsiDOY  GregorianDate  GregorianDOY
13690101    1          19900322      80
13690102    2          19900323      81
...
\end{lstlisting}

