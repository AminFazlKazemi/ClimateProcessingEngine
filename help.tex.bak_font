    tmin\_pearson\_p1 & float32 & Pearson Type III: shape \\
    tmin\_pearson\_p2 & float32 & Pearson Type III: scale \\
    tmin\_pearson\_p3 & float32 & Pearson Type III: location \\
    tmin\_pearson\_loglik & float32 & Pearson Type III: log-likelihood \\
    tmin\_pearson\_aicc & float32 & Pearson Type III: AICc \\
    
    \midrule
    \multicolumn{3}{c}{\textbf{tmean Variables (same structure)}} \\
    \midrule
    \multicolumn{3}{c}{\textit{... (30 variables with tmean\_ prefix)}} \\
    
    \midrule
    \multicolumn{3}{c}{\textbf{tmax Variables (same structure)}} \\
    \midrule
    \multicolumn{3}{c}{\textit{... (30 variables with tmax\_ prefix)}} \\
    
\end{longtable}

\chapter{Configuration File Reference}
\begin{lstlisting}[caption=Full config.yaml with Descriptions]
# Paths
paths:
  calendar_file: K:/Temp/needed/calendar.txt      # Path to Persian calendar file
  checkpoint_file: checkpoint.csv                 # Checkpoint file name
  output_dir: I:/climatology_366_rolling          # Output directory
  output_zarr_name: climatology_stationwise_final.zarr  # Output file name
  zarr_base: K:/.../zarr_yearly_monthly           # Input Zarr base directory

# Time Range
years:
  start: 1369                                     # First year (Persian calendar)
  end: 1399                                       # Last year (inclusive)
days: 366                                         # Days per year (365 or 366)
window_days: 2                                    # Window size ± days

# Processing
block_size: 1000                                  # Stations per block
cores: 6                                          # CPU cores for parallel
use_parallel: false                               # Enable parallel processing

# Variables
variables:
- tmin                                           # Variables to process
- tmean
- tmax
fit_variable_index: 1                            # Index for fitting (0=tmin, 1=tmean, 2=tmax)

# Validation
validation:
  validate_after_load: true                      # Validate after loading
  validate_before_write: true                    # Validate before writing
  validate_every_n_blocks: 5                     # Validate every N blocks

# Logging
logging:
  level: INFO                                    # Log level (DEBUG, INFO, WARNING, ERROR)
  log_file: climatology.log                      # Log file name
  log_timestamps: true                           # Include timestamps in logs

# Benchmark
benchmark:
  enabled: true                                  # Enable benchmarking
  run_on_first_block: true                       # Run benchmark on first run
  test_block_sizes:                              # Block sizes to test
  - 500
  - 1000
  - 1500
  - 2000
  - 3000
\end{lstlisting}

\chapter{Example Usage}
\section{Running the Engine}
\begin{lstlisting}[caption=Basic Execution]
cd K:/gozareshha/dr vazife/140504 - qc temp/climatology/climatology_engine
python main.py
\end{lstlisting}

\section{Resuming After Interruption}
Simply run \texttt{python main.py} again. The engine will automatically detect the checkpoint and resume.

\section{Starting Fresh}
To start from scratch:
\begin{lstlisting}[caption=Starting Fresh]
rm checkpoint.csv
rm -rf I:/climatology_366_rolling/climatology_stationwise_final.zarr
python main.py
\end{lstlisting}

\section{Analyzing Results}
After the engine completes:
\begin{lstlisting}[caption=Analyzing Results]
cd ../..
python analyze_distributions1.py
\end{lstlisting}

\section{Example: Custom Configuration}
\begin{lstlisting}[caption=Custom Configuration Example]
# config.yaml
paths:
  output_dir: /data/climate/output
  output_zarr_name: my_climate_results.zarr
  zarr_base: /data/climate/input
years:
  start: 1370
  end: 1400
block_size: 2000
cores: 8
use_parallel: true
variables:
- tmin
- tmax
\end{lstlisting}

\chapter{Glossary}
\begin{longtable}{p{3cm} p{10cm}}
    \caption{Glossary of Terms}
    \label{tab:glossary} \\
    \toprule
    \textbf{Term} & \textbf{Definition} \\
    \midrule
    \endfirsthead
    \toprule
    \textbf{Term} & \textbf{Definition} \\
    \midrule
    \endhead
    \bottomrule
    \endfoot
    
    \textbf{AIC} & Akaike Information Criterion – measures model quality balancing fit and complexity. \\
    \textbf{AICc} & Corrected AIC – with small-sample correction. \\
    \textbf{BIC} & Bayesian Information Criterion – alternative to AIC with stronger penalty for complexity. \\
    \textbf{Block} & A contiguous group of stations processed together for efficiency. \\
    \textbf{Checkpoint} & A saved state that allows resuming after interruption. \\
    \textbf{Doy} & Day of Year – a number from 1 to 365 (or 366) representing the day. \\
    \textbf{Fit} & The process of estimating distribution parameters from data. \\
    \textbf{GEV} & Generalized Extreme Value – a family of distributions for extreme events. \\
    \textbf{Log-likelihood} & The logarithm of the likelihood function, used in model selection. \\
    \textbf{NaN} & Not a Number – used to represent missing data. \\
    \textbf{Numba} & A Python library for just-in-time compilation that accelerates numerical computations. \\
    \textbf{Pearson III} & A three-parameter Gamma distribution, also known as a shifted Gamma. \\
    \textbf{Skew-Normal} & A distribution that extends the Normal with a shape parameter for asymmetry. \\
    \textbf{Window} & A set of days around a target day used for estimation (e.g., ±2 days). \\
    \textbf{Zarr} & A Python library for chunked, compressed, N-dimensional arrays. \\
    \textbf{Zarr Store} & A directory containing Zarr data and metadata. \\
    
\end{longtable}

\end{document}	