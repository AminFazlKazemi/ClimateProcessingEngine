\subsubsection{Bimodal Normal Distribution}
\begin{lstlisting}[caption=Bimodal Fitting]
@njit
def fit_bimodal_full_numba(data):
    """
    Fit a Bimodal Normal distribution using moment-based estimation.
    
    Returns:
        tuple: (w1, mu1, sigma1, mu2, sigma2, loglikelihood, AICc, BIC, n_parameters)
    """
    # Estimates 5 parameters from moments:
    #   w1: mixing weight of component 1
    #   mu1, sigma1: mean and std of component 1
    #   mu2, sigma2: mean and std of component 2
    # Uses kurtosis to estimate separation between modes
\end{lstlisting}

\subsubsection{Pearson Type III Distribution}
\begin{lstlisting}[caption=Pearson Type III Fitting]
@njit
def fit_pearson3_full_numba(data):
    """
    Fit a Pearson Type III (Gamma) distribution.
    
    Returns:
        tuple: (shape, scale, location, loglikelihood, AICc, BIC, n_parameters)
    """
    # Uses method of moments with skewness adjustment
    # Applies Wilson-Hilferty transformation for initial estimates
    # Computes log-likelihood via Gamma PDF
\end{lstlisting}

\subsubsection{Master Fitting Function}
\begin{lstlisting}[caption=fit\_all\_distributions\_numba]
@njit
def fit_all_distributions_numba(data):
    """
    Fit all four distributions and select the best.
    
    Returns:
        ndarray: 30-element array containing:
            [0]  best_dist (0=Normal, 1=Skew, 2=Bimodal, 3=Pearson, -1=failed)
            [1]  mean
            [2]  std
            [3]  skewness
            [4]  median
            [5]  count
            [6]  normal_p1 (mean)
            [7]  normal_p2 (std)
            [8]  normal_loglik
            [9]  normal_aicc
            [10] normal_bic
            [11] skew_p1 (alpha)
            [12] skew_p2 (loc)
            [13] skew_p3 (scale)
            [14] skew_loglik
            [15] skew_aicc
            [16] skew_bic
