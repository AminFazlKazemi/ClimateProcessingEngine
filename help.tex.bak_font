\chapter{Mathematical Background}

\section{Distributions}
\subsection{Normal Distribution}
\[
f(x) = \frac{1}{\sqrt{2\pi\sigma^2}} \exp\left(-\frac{(x-\mu)^2}{2\sigma^2}\right)
\]
Parameters: $\mu$ (location), $\sigma > 0$ (scale)

\subsection{Skew-Normal Distribution}
\[
f(x) = \frac{2}{\omega} \phi\left(\frac{x-\xi}{\omega}\right) \Phi\left(\alpha\frac{x-\xi}{\omega}\right)
\]
where $\phi$ is the standard Normal PDF, $\Phi$ the standard Normal CDF, $\xi$ location, $\omega > 0$ scale, $\alpha$ shape.

\subsection{Bimodal Normal Distribution}
\[
f(x) = w_1 \mathcal{N}(x; \mu_1, \sigma_1^2) + w_2 \mathcal{N}(x; \mu_2, \sigma_2^2)
\]
with $w_1 + w_2 = 1$, $0 \le w_i \le 1$, $\sigma_i > 0$.

\subsection{Pearson Type III Distribution}
\[
f(x) = \frac{1}{\Gamma(\alpha)\beta^\alpha} (x-\gamma)^{\alpha-1} \exp\left(-\frac{x-\gamma}{\beta}\right)
\]
with shape $\alpha > 0$, scale $\beta > 0$, location $\gamma$.

\section{Model Selection Criteria}
\subsection{AIC (Akaike Information Criterion)}
\[
\text{AIC} = 2k - 2\ln(\hat{L})
\]
\subsection{AICc (Corrected AIC)}
\[
\text{AICc} = \text{AIC} + \frac{2k(k+1)}{n - k - 1}
\]
\subsection{BIC (Bayesian Information Criterion)}
\[
\text{BIC} = k\ln(n) - 2\ln(\hat{L})
\]

\section{Bimodality Metrics}
\subsection{Ashman's D}
\[
D = \frac{|\mu_2 - \mu_1|}{\sqrt{\frac{\sigma_1^2 + \sigma_2^2}{2}}}
\]
\subsection{Bimodality Coefficient}
\[
\text{BC} = \frac{\text{skewness}^2 + 1}{\text{kurtosis} + 1}
\]
\subsection{Overlap Coefficient}
\[
\text{OVL} = \int_{-\infty}^{\infty} \min\{f_1(x), f_2(x)\} \, dx
\]

\section{Window-Based Estimation}
For each day $d$, the engine extracts values from days $d-2$ to $d+2$ (total 5 days) across all years:
\[
\text{Window}_d = \{x_{y, t} : y \in \text{years}, t \in [d-2, d+2]\}
\]
with wrapping at boundaries.

