    \begin{tabular}{l l l}
        \toprule
        \textbf{Variable} & \textbf{Shape} & \textbf{Description} \\
        \midrule
        \texttt{tmin} & \texttt{(days, points)} & Minimum temperature (raw) \\
        \texttt{tmax} & \texttt{(days, points)} & Maximum temperature (raw) \\
        \texttt{tmean} & \texttt{(days, points)} & Mean temperature (raw, scaled by 10) \\
        \texttt{stationid} & \texttt{(points,)} & Station identifiers \\
        \texttt{lat} & \texttt{(points,)} & Latitude \\
        \texttt{lon} & \texttt{(points,)} & Longitude \\
        \texttt{elev} & \texttt{(points,)} & Elevation \\
        \bottomrule
    \end{tabular}
\end{table}

\section{Data Scaling}
The \texttt{tmean} data is stored with a scaling factor of 10 (actual = stored / 10). The engine automatically handles this scaling during loading.

\section{Missing Data}
Missing values are stored as \texttt{NaN} and are handled appropriately.

