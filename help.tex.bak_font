    \begin{tabular}{l r l}
        \toprule
        \textbf{Constant} & \textbf{Value} & \textbf{Description} \\
        \midrule
        \texttt{WINDOW\_SIZE} & 5 & Days in window (2 before + target + 2 after) \\
        \texttt{MAX\_VALUES\_PER\_FIT} & 155 & \texttt{N\_YEARS * WINDOW\_SIZE} \\
