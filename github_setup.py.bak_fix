import os
import requests
import base64

TOKEN = os.environ.get("GITHUB_TOKEN")

if not TOKEN:
    print("ERROR: GITHUB_TOKEN not found")
    exit()

OWNER = "AminFazlKazemi"
REPO = "ClimateProcessingEngine"

API = f"https://api.github.com/repos/{OWNER}/{REPO}"

HEADERS = {
    "Authorization": f"token {TOKEN}",
    "Accept": "application/vnd.github+json"
}


# ============================
# 1- Update Description
# ============================

data = {
    "description": "Climate Processing Engine - Geospatial climate analysis, processing pipelines, and visualization tools"
}

r = requests.patch(
    API,
    headers=HEADERS,
    json=data
)

print("Description:", r.status_code)


# ============================
# 2- Add MIT License
# ============================

LICENSE = """MIT License

Copyright (c) 2026 Amin Fazl Kazemi

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files.
"""

content = base64.b64encode(
    LICENSE.encode("utf-8")
).decode("utf-8")


license_api = f"{API}/contents/LICENSE"

check = requests.get(
    license_api,
    headers=HEADERS
)


if check.status_code == 404:

    r = requests.put(
        license_api,
        headers=HEADERS,
        json={
            "message": "Add MIT License",
            "content": content
        }
    )

    print("LICENSE:", r.status_code)

else:
    print("LICENSE already exists")


# ============================
# 3- Create Release
# ============================

release = {
    "tag_name": "v1.0.0",
    "target_commitish": "main",
    "name": "ClimateProcessingEngine v1.0.0",
    "body": """
First official release.

Features:

- Climate processing pipeline
- Geospatial analysis tools
- Visualization modules
- Initial stable version
""",
    "draft": False,
    "prerelease": False
}


r = requests.post(
    API + "/releases",
    headers=HEADERS,
    json=release
)

print("Release:", r.status_code)

print("\nDONE ✅")